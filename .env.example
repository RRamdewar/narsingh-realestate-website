# ─── Microsoft Graph / calendar configuration ───────────────────────────────
# Copy this file to `.env.local` for local development, and set the same values
# as GitHub Actions repository "Variables" (Settings → Secrets and variables →
# Actions → Variables) so the deployed site is configured at build time.
#
# None of these are secrets — a SPA "public client" App Registration has no
# client secret — but they are kept out of source control so the account can be
# changed without editing code.

# Azure AD App Registration (SPA) — Application (client) ID. REQUIRED for the
# owner calendar dashboard at /#/calendar
VITE_MS_CLIENT_ID=

# Sign-in authority. Use your tenant ID for a work/school account, or:
#   https://login.microsoftonline.com/common      (work + personal)
#   https://login.microsoftonline.com/consumers   (personal Microsoft accounts)
VITE_MS_AUTHORITY=https://login.microsoftonline.com/common

# Optional: override the OAuth redirect URI. Defaults to the site's own URL.
# Must EXACTLY match a redirect URI registered on the App Registration (SPA).
# VITE_MS_REDIRECT_URI=https://rramdewar.github.io/narsingh-realestate-website/

# Whose calendar this is (shown in the UI and used for booking emails).
VITE_OWNER_NAME=Brandon Narsingh
VITE_OWNER_EMAIL=brandon@narsinghteam.com

# Public availability source: an Outlook "published calendar" ICS link.
# Outlook on the web → Settings → Calendar → Shared calendars → Publish a
# calendar → "Can view when I'm busy" → copy the ICS link. REQUIRED for the
# public availability page at /#/availability
VITE_PUBLISHED_ICS_URL=

# ─── Optional availability tuning ───────────────────────────────────────────
# VITE_AVAILABILITY_DAYS=14     # how many days ahead to show
# VITE_SLOT_MINUTES=30          # length of each bookable slot
# VITE_DAY_START_HOUR=9         # business hours start (24h, local time)
# VITE_DAY_END_HOUR=18          # business hours end (24h, local time)
# VITE_WORKDAYS=1,2,3,4,5       # bookable days, 0=Sun … 6=Sat
# VITE_LEAD_TIME_HOURS=2        # minimum notice before the first slot
